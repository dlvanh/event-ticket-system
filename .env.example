# Database (MySQL)
MYSQL_DATABASE=onlinetickets
MYSQL_ROOT_PASSWORD=change_me_root_password
DB_HOST=mysql
DB_PORT=3306
DB_NAME=onlinetickets
DB_USERNAME=root
DB_PASSWORD=change_me_root_password

# Redis (OTP & email verification store)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Backend Server & Security
SERVER_PORT=8080
# Minimum 64 bytes for HS512 (generate with: openssl rand -hex 64)
JWT_SECRET=replace-with-a-strong-random-secret-key-at-least-64-characters-long-for-hs512
JWT_EXPIRATION_MS=86400000
# Separate secret for signing ticket check-in QR codes
QR_SIGNING_SECRET=replace-with-a-strong-random-qr-signing-secret-at-least-32-chars
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost,http://10.0.2.2:8081

# Mail (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_FROM=your-email@gmail.com

# Third-party integrations
IMGBB_API_KEY=your-imgbb-api-key
PAYOS_CLIENT_ID=your-payos-client-id
PAYOS_API_KEY=your-payos-api-key
PAYOS_CHECKSUM_KEY=your-payos-checksum-key
GEMINI_API_KEY=your-gemini-api-key

# Google OAuth2 (optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Docker Compose host ports
FRONTEND_PORT=4200
BACKEND_PORT=8080
MYSQL_HOST_PORT=3306
REDIS_HOST_PORT=6379
